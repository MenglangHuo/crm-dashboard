# ============================================================
# PRODUCTION ENVIRONMENT CONFIGURATION (NODE_ENV=production)
# Automatically loaded by Next.js during 'pnpm build' & 'pnpm start'
# ============================================================

NEXT_PUBLIC_APP_ENV=production

# Production Backend API URL (Single Source of Truth)
NEXT_PUBLIC_API_BACKEND_URL=https://crmapi.bronxtechnology.site

# Browser client base path
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_API_TIMEOUT=10000

# Insecure TLS disabled in production
NEXT_PUBLIC_ALLOW_INSECURE_TLS=false

# Disable verbose debug logs in production
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=false
