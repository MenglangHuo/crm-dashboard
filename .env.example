# ============================================================
# CRM DASHBOARD - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Next.js automatically loads environment variables by mode:
# - 'pnpm dev' loads: .env.development.local -> .env.local -> .env.development -> .env
# - 'pnpm build'/'pnpm start' loads: .env.production.local -> .env.local -> .env.production -> .env
#
# Available commands:
# - 'pnpm dev'        -> Run dev mode with .env.development (http://localhost:8091)
# - 'pnpm dev:prod'   -> Run dev mode with .env.production (https://crmapi.bronxtechnology.site)
# - 'pnpm build'      -> Build prod mode with .env.production
# - 'pnpm build:dev'  -> Build prod mode with .env.development
# - 'pnpm start'      -> Run built production server
# ============================================================

# Target environment: development | production | test
NEXT_PUBLIC_APP_ENV=development

# Backend Spring Boot API server URL (Single Source of Truth)
# - Development: http://localhost:8091 (or http://localhost:8090)
# - Production:  https://crmapi.bronxtechnology.site
NEXT_PUBLIC_API_BACKEND_URL=http://localhost:8091

# Browser client base path (same-origin relative URL to prevent CORS issues)
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Axios request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=15000

# Allow insecure TLS in development (useful when testing against staging/expired SSL certs)
NEXT_PUBLIC_ALLOW_INSECURE_TLS=false

# Developer logging
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=true

# Branding & App Metadata
NEXT_PUBLIC_COMPANY_NAME=CRM Enterprise
NEXT_PUBLIC_COMPANY_TAGLINE="Loan operations, customers, and branches in one focused workspace."
NEXT_PUBLIC_COMPANY_LOGO_URL=/icon.svg
NEXT_PUBLIC_LOGIN_IMAGE_URL=/bg-blossom.png
NEXT_PUBLIC_COMPANY_PRIMARY_COLOR=#2252E9
NEXT_PUBLIC_COMPANY_SUPPORT_EMAIL=support@bronxtechnology.site
