# ============================================================
# API & Backend Configuration
# ============================================================
# Browser client base path (same-origin relative URL to prevent CORS issues)
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Axios request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=15000

# Backend Spring Boot API server URL (REQUIRED for Next.js rewrites & proxy handlers)
# Local development: http://localhost:8091 (or http://localhost:8090)
# Production / Vercel: https://your.domain.site
NEXT_PUBLIC_API_BACKEND_URL=https://your.domain.site

NEXT_PUBLIC_COMPANY_NAME=Crm
NEXT_PUBLIC_COMPANY_TAGLINE="Loan operations, customers, and branches in one focused workspace."
NEXT_PUBLIC_COMPANY_LOGO_URL=/icon.svg
NEXT_PUBLIC_LOGIN_IMAGE_URL=/bg-blossom.png 
NEXT_PUBLIC_COMPANY_PRIMARY_COLOR=#1d232a
NEXT_PUBLIC_COMPANY_ACCENT_COLOR=#5f8d6b
NEXT_PUBLIC_COMPANY_SUPPORT_EMAIL=support@crm.com
NEXT_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id_here
