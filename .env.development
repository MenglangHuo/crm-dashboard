# ============================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION (NODE_ENV=development)
# Automatically loaded by Next.js during 'pnpm dev'
# ============================================================

NEXT_PUBLIC_APP_ENV=development

# Backend Spring Boot API server for local development
NEXT_PUBLIC_API_BACKEND_URL=http://localhost:8091

# Browser client base path (relative URL proxied to backend, avoids CORS)
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_API_TIMEOUT=15000

# Allow insecure TLS in development (useful when testing against staging/expired SSL certificates)
NEXT_PUBLIC_ALLOW_INSECURE_TLS=true

# Developer logging
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=true
